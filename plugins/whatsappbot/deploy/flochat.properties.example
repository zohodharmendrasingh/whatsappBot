# FloChat server settings -> copy to /etc/flochat/flochat.properties (chmod 640, owner flochat)
# Values here override plugins/whatsappbot/config/whatsappbot.properties. Keep secrets ONLY here.
# The file is re-read automatically a few seconds after you save it.

# ---- Public address
brand.app.url=https://flochat.flolink.ai
brand.domain=flochat.flolink.ai
brand.support.email=info@msoftdynamic.com

# ---- Meta / WhatsApp (developers.facebook.com > FloChat app)
meta.app.id=2484887488701796
meta.app.secret=
meta.embedded.signup.config.id=1048501558221577
# any random string, also typed into Meta > WhatsApp > Configuration > Webhook
webhook.verify.token=

# ---- PayPal (developer.paypal.com > Apps & Credentials > Live)
paypal.mode=live
paypal.client.id=
paypal.client.secret=

# ---- Sign-up
saas.signup.enabled=true
# remove WA_TEST once live payments are tested
saas.hidden.plans=WA_TEST

# AI bot builder (Claude API). Each workspace adds its OWN key in Settings > AI assistant (stored encrypted).
# ai.api.key here is only an optional platform fallback for workspaces without a key; leave empty so customers pay their own usage.
ai.provider=anthropic
ai.api.key=
ai.model=claude-sonnet-5
ai.daily.limit=30
ai.daily.limit.own.key=200

# Zoho (CRM, Books, Inventory, People). ONE FloChat client from api-console.zoho.com (Server-based Application)
# serves every customer; each workspace connects its own Zoho account in Settings > Zoho.
# Redirect URL to register in the Zoho API Console: https://flochat.flolink.ai/control/zohoCallback
# Enable other data centres in the client's Settings tab; if they have different secrets, add zoho.client.secret.in / .eu / ...
zoho.client.id=
zoho.client.secret=
zoho.redirect.uri=https://flochat.flolink.ai/control/zohoCallback
# Country code assumed for phone numbers saved in Zoho without one (default: taken from the business's WhatsApp number)
zoho.default.country.code=
